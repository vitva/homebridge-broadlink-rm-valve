{
  "name": "homebridge-broadlink-rm-valve",
  "displayName": "Homebridge Broadlink RM Pro + Valve",
  "version": "4.4.21-valve.5",
  "description": "Broadlink RM plugin for Homebridge, with an additional water valve accessory.",
  "license": "Apache-2.0",
  "scripts": {
    "release": "release-it",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test:valve": "node scripts/test-valve.js",
    "test": "mocha --recursive test --exit && npm run test:valve && node scripts/test-config-schema.js && npm run test:exports",
    "test:exports": "node scripts/test-module-exports.mjs"
  },
  "keywords": [
    "homebridge-plugin",
    "broadlink",
    "rm pro 3",
    "rm mini 3",
    "rm4",
    "valve",
    "water-valve",
    "supports-hap"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "author": {
    "name": "vitva (fork of kiwi-cam/homebridge-broadlink-rm)"
  },
  "funding": "https://paypal.me/kiwicamRM",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitva/homebridge-broadlink-rm-valve.git"
  },
  "dependencies": {
    "await-semaphore": "^0.1.3",
    "chai": "^4.3.7",
    "fakegato-history": "^0.6.5",
    "find-key": "^2.1.3",
    "github-version-checker": "^2.3.0",
    "kiwicam-broadlinkjs-rm": "^0.9.22",
    "mqtt": "^5.14.0",
    "node-arp": "^1.0.6",
    "node-persist": ">=2.1.0 <3.0.0",
    "ping": "^0.4.4",
    "semver": "^7.5.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-no-autofix": "^1.2.3",
    "globals": "^16.3.0",
    "hap-nodejs": "^0.12.2",
    "mocha": "^12.0.3",
    "release-it": "^21.1.3"
  },
  "bugs": {
    "url": "https://github.com/vitva/homebridge-broadlink-rm-valve/issues"
  },
  "homepage": "https://github.com/vitva/homebridge-broadlink-rm-valve#readme",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "overrides": {
    "uuid": "$uuid",
    "mocha": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
